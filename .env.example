# Copy to .env. Generate a password, then use the same URL-encoded value below.
APP_ENV=development
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
PUBLIC_URL=http://localhost:5173
COOKIE_SECURE=false
LOG_LEVEL=INFO
POSTGRES_USER=velora
POSTGRES_DB=velora
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgres://velora:replace-with-a-random-password@127.0.0.1:5432/velora?sslmode=disable
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
