{
  "openapi": "3.0.3",
  "info": {
    "title": "Velora Core",
    "version": "0.1.0",
    "description": "Same-origin cookie API. Mutations require Origin matching PUBLIC_URL and application/json. Nodes are metadata only; lists return the latest 100."
  },
